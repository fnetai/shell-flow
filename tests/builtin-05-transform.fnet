# Test: Transform Builtins
# Category: Builtin
# Level: Simple
# Description: String transformation operations

commands:
  - echo: "Test: Transform builtins"
  
  # Uppercase
  - transform::uppercase::upper: "hello world"
  - echo: "Uppercase: {{$.upper}}"
  
  # Lowercase
  - transform::lowercase::lower: "HELLO WORLD"
  - echo: "Lowercase: {{$.lower}}"
  
  # Trim
  - transform::trim::trimmed: "  hello world  "
  - echo: "Trimmed: '{{$.trimmed}}'"
  
  - echo: "Transform tests completed!"

